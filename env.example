# Database Configuration
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/flashfire?retryWrites=true&w=majority

# JWT Configuration
JWT_SECRET=your-super-secure-jwt-secret-key-here

# Crypto Configuration
CRYPTO_ALGORITHM=aes-256-cbc
CRYPTO_AES_SECRET_SECRET_KEY=your-32-character-crypto-secret-key-here
CRYPTO_IV_LENGTH=16

# Server Configuration
PORT=8001
NODE_ENV=production

# CORS Configuration
ALLOWED_ORIGINS=https://your-frontend-domain.com,https://www.your-frontend-domain.com

# Cloudinary Configuration (Legacy - for existing files)
CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret
CLOUDINARY_UPLOAD_PRESET=your-cloudinary-upload-preset

# Cloudflare R2 Configuration (Recommended for new uploads)
# Used for file attachments AND resume data storage (NEW: reduces MongoDB size by 95-99%)
# Resume data is automatically stored in R2 organized by client folders
# See RESUME_DATA_R2_MIGRATION.md for details
USE_R2_FOR_NEW_UPLOADS=true
R2_ENDPOINT=https://ea7feaa0807f23a74111f715fbf1c169.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=87ccb6169189c8547df2d4533098d501
R2_SECRET_ACCESS_KEY=5803b4a0bd17d07a19164aefc1a7b7636244380fcf4d48fb2e159e1008c2aa34
R2_BUCKET_NAME=flashfire-storage
R2_PUBLIC_URL=https://pub-9122bde92eac495f8beda15ee45552dd.r2.dev/test

# Frontend Configuration
VITE_API_BASE_URL=https://your-backend-api.com
VITE_CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
VITE_CLOUDINARY_CLOUD_PRESET=your-cloudinary-upload-preset
VITE_CLOUDINARY_CLOUD_PRESET_PDF=your-cloudinary-pdf-preset

# OpenAI Configuration (Backend)
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-4o-mini

# Optional: Google OAuth Configuration
VITE_GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=https://your-backend-api.com/gmail/auth/google/callback

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Security
BCRYPT_ROUNDS=12
SESSION_SECRET=your-session-secret-key

# Logging
LOG_LEVEL=info

# ---- Scrape-cost Discord notifier ----
# Webhook URL the backend POSTs to when today's cumulative extension scrape
# count crosses each 5000-job milestone (5k, 10k, 15k, …). Get one in your
# Discord channel → Edit Channel → Integrations → Webhooks → New Webhook
# → Copy URL. Leave blank to disable.
DISCORD_SCRAPE_WEBHOOK_URL=

# Cost-math constants surfaced in the milestone embed. Defaults reflect
# gpt-4o-mini pricing as of 2025-04. Override only when OpenAI changes
# pricing OR when batch-size / token-budget changes in the extension.
OPENAI_INPUT_PER_M=0.15        # USD per 1M input tokens
OPENAI_OUTPUT_PER_M=0.60       # USD per 1M output tokens
AI_BATCH_SIZE=8                # jobs per OpenAI call (must match extension's DEFAULTS.autoBatchSize)
AI_TOKENS_IN_PER_BATCH=8800    # avg input tokens per batch (8 × ~1100)
AI_TOKENS_OUT_PER_BATCH=500    # avg output tokens per batch (JSON decisions)
USD_INR_FIXED=94               # fixed exchange rate for INR display
