# Database Configuration
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/flashfire?retryWrites=true&w=majority

# JWT Configuration
JWT_SECRET=your-super-secure-jwt-secret-key-here

# Crypto Configuration
CRYPTO_ALGORITHM=aes-256-cbc
CRYPTO_AES_SECRET_SECRET_KEY=your-32-character-crypto-secret-key-here
CRYPTO_IV_LENGTH=16

# Server Configuration
PORT=8001
NODE_ENV=production

# Local development only — NEVER set these in a deployed environment.
# When DEV_SESSION_KEY_BYPASS is exactly "true", /operations/verify-session-key
# accepts DEV_SESSION_KEY and /operations/verify-otp accepts DEV_OTP_CODE, so
# you can get past the second factor without a generated key or a working
# mailer. Password login is still enforced and the operator must exist in the
# database. Prefer `npm run dev:bypass` over setting it in a file, so it cannot
# be committed or deployed by accident.
# DEV_SESSION_KEY_BYPASS=true
# DEV_SESSION_KEY=00000000
# DEV_OTP_CODE=0000

# CORS Configuration
ALLOWED_ORIGINS=https://your-frontend-domain.com,https://www.your-frontend-domain.com

# Cloudinary Configuration (Legacy - for existing files)
CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret
CLOUDINARY_UPLOAD_PRESET=your-cloudinary-upload-preset

# Cloudflare R2 Configuration (Recommended for new uploads)
# Used for file attachments AND resume data storage (NEW: reduces MongoDB size by 95-99%)
# Resume data is automatically stored in R2 organized by client folders
# See RESUME_DATA_R2_MIGRATION.md for details
USE_R2_FOR_NEW_UPLOADS=true
R2_ENDPOINT=https://ea7feaa0807f23a74111f715fbf1c169.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=87ccb6169189c8547df2d4533098d501
R2_SECRET_ACCESS_KEY=5803b4a0bd17d07a19164aefc1a7b7636244380fcf4d48fb2e159e1008c2aa34
R2_BUCKET_NAME=flashfire-storage
R2_PUBLIC_URL=https://pub-9122bde92eac495f8beda15ee45552dd.r2.dev/test

# Frontend Configuration
VITE_API_BASE_URL=https://your-backend-api.com
VITE_CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
VITE_CLOUDINARY_CLOUD_PRESET=your-cloudinary-upload-preset
VITE_CLOUDINARY_CLOUD_PRESET_PDF=your-cloudinary-pdf-preset

# OpenAI Configuration (Backend)
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-4o-mini

# ---- Second-stage screening (secondJudgeWorker) ----
# Re-judges every extension-pushed job against the REAL employer-site text.
# A DB-polled worker (no Redis) opens job.joblink via the scraper, scrapes the
# full posting, and re-grades it on LOCATION + FRESHNESS with the client profile.
#   • a CLOSED / EXPIRED posting is moved to the "removed by AI" column at once;
#   • a LOCATION mismatch is only FLAGGED — the job stays put for operator review;
#   • passes and un-screenable jobs are kept.
SECOND_JUDGE_ENABLED=true                 # set false to disable the worker
SECOND_JUDGE_THRESHOLD=50                 # min grade (0-100) to keep a job
SECOND_JUDGE_POLL_INTERVAL_MS=10000       # idle poll cadence
SECOND_JUDGE_DELAY_BETWEEN_JOBS_MS=2000   # gap between consecutive jobs
SECOND_JUDGE_CONCURRENCY=6                # jobs screened in parallel (scraper has ~6 slots)
SECOND_JUDGE_MAX_ATTEMPTS=3               # retries before failing OPEN (kept, 'skipped')
SECOND_JUDGE_MIN_JD_CHARS=200             # below this the scrape is treated as a failure
SECOND_JUDGE_SCRAPER_TIMEOUT_MS=45000     # scraper /extract request timeout
SECOND_JUDGE_OPENAI_TIMEOUT_MS=30000      # grader request timeout
SECOND_JUDGE_AUTO_REMOVE_ENABLED=true     # false → stale postings are flagged, not removed
# NOTE: the freshness window is NOT configurable here. A posting older than 3 days
# is expired and is moved to the Removed column. That is product policy, so it
# lives in code as STALE_POSTING_DAYS in Utils/secondJudgePrompt.js — the same
# constant the grader's worked examples are generated from, so the prompt and the
# deterministic gate can never disagree about what "expired" means.
SECOND_JUDGE_REQUEUE_LEGACY_FLAGS=true    # one-shot re-screen of pre-upgrade freshness flags
SECOND_JUDGE_AUDIT_LEGACY_REMOVALS=true  # boot-time READ-ONLY count of jobs the old 24h sweep removed
# OPENAI_JUDGE_MODEL=gpt-4o-mini          # optional override (defaults to OPENAI_MODEL)

# Scraper service (Playwright text extractor). Must match the extension's
# exports.js SCRAPER_BASE_URL. EXTRACT_PATH matches SCRAPER_ENDPOINTS.EXTRACT_INFO.
SCRAPER_BASE_URL=http://34.100.143.80:8092
SCRAPER_EXTRACT_PATH=/extract/infor=

# Google OAuth Configuration
# REQUIRED for Google Sign-In. GOOGLE_CLIENT_ID is the audience the backend
# checks on every Google ID token; if it is unset, /google-oauth refuses to run
# (leaving it blank would silently disable the aud check and accept tokens
# minted by any third-party Google OAuth client). It must match the frontend's
# VITE_GOOGLE_OAUTH_CLIENT_ID exactly.
VITE_GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=https://your-backend-api.com/gmail/auth/google/callback

# REQUIRED to create accounts. POST /api/clients/register rejects every request
# that does not present this value in an `x-admin-key` header, and returns 503
# if the variable is unset. Sign-in only works for accounts that already exist,
# so account creation is deliberately admin-only.
ADMIN_REGISTRATION_KEY=generate-with-openssl-rand-hex-32

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Security
BCRYPT_ROUNDS=12
SESSION_SECRET=your-session-secret-key

# Logging
LOG_LEVEL=info

# ---- Scrape-cost Discord notifier ----
# Webhook URL the backend POSTs to when today's cumulative extension scrape
# count crosses each 5000-job milestone (5k, 10k, 15k, …). Get one in your
# Discord channel → Edit Channel → Integrations → Webhooks → New Webhook
# → Copy URL. Leave blank to disable.
DISCORD_SCRAPE_WEBHOOK_URL=

# Cost is MEASURED, not estimated. Every LLM call records the token counts the
# provider actually reported (Utils/aiUsage.js → AiUsageDaily) and the milestone
# embed prices those. Stage-1 judge batches run inside the extension, which
# reports its usage via ExtensionSessionStat.modelStats.
#
# NOTHING about cost is configurable here. There are NO env vars for it — not
# pricing, not the FX rate, not batch size, not the fallback token estimates.
# These were removed on purpose: an env-tunable cost constant is exactly how the
# old 2.3x under-report survived, with the correct value sitting in this file
# while production silently ran a different code default. Cost math is
# measurement, not deployment config, so it lives in code where a change shows
# up in a diff and gets reviewed:
#
#   Utils/aiRateCard.js       per-model $/1M rates (incl. cached-input rate),
#                             and the fixed ₹94/USD display rate
#   Utils/scrapeCostNotifier.js  batch size, the hardcoded gpt-4o-mini judge
#                             model, and the fallback-only token estimates
#
# These vars are no longer read and can be deleted from your environment:
#   OPENAI_INPUT_PER_M  OPENAI_OUTPUT_PER_M  USD_INR_FIXED  AI_BATCH_SIZE
#   AI_TOKENS_IN_PER_BATCH  AI_TOKENS_OUT_PER_BATCH  AI_CACHED_TOKENS_PER_BATCH
#
# Reconcile any Discord figure against the OpenAI dashboard with:
#   GET /admin/ai-cost              → today, by pipeline + model
#   GET /admin/ai-cost?days=14      → daily trend

# ============================================================
#  Inbound mail pipeline — Gmail → gpt-4o-mini → Discord
#  (src/services/mailPollWorker.js)
# ============================================================
# DISABLED BY DEFAULT. We do not capture client mail or forward it to Discord.
# Nothing below has any effect unless MAIL_POLL_ENABLED=1 is set explicitly.
#
# When enabled: every hour, each connected client mailbox is polled for new
# INBOX mail. Each new mail is summarized by gpt-4o-mini and posted to Discord
# as an embed carrying the client's info, the summary, extracted links, and any
# .txt attachment uploaded as a real Discord file.

# Where mail digests are posted. Discord channel → Edit Channel →
# Integrations → Webhooks → New Webhook → Copy URL.
# REQUIRED — leave blank and mails are still summarized + stored, but never posted.
DISCORD_MAIL_WEBHOOK_URL=

# Where "reconnect the mail" (invalid_grant) alerts go.
# Defaults to DISCORD_MAIL_WEBHOOK_URL when blank.
DISCORD_MAIL_ERROR_WEBHOOK_URL=

# Optional role/user ping prepended to auth-error alerts, e.g. <@&123456789>
DISCORD_MAIL_ALERT_MENTION=

# Deep link shown in the auth-error embed so ops can reconnect in one click.
# e.g. https://dashboard.flashfire.io/inbox
GMAIL_RECONNECT_URL=

# Master switch. Opt-IN: ONLY the exact value 1 turns mail capture back on.
# Anything else (unset, 0, "true", "yes") leaves the whole pipeline inert —
# no polling, no gpt-4o-mini summaries, no Discord posts, and POST
# /gmail/poll-now answers 503 instead of running a poll.
MAIL_POLL_ENABLED=0
MAIL_POLL_CRON=0 * * * *       # hourly, on the hour (Asia/Kolkata)
MAIL_POLL_RUN_ON_BOOT=0        # 1 = also poll ~8s after startup
MAIL_POLL_CONCURRENCY=2        # mailboxes polled in parallel
MAIL_POLL_MAX_PER_TICK=25      # mails summarized per mailbox per tick (overflow resumes next tick)
MAIL_POLL_MAX_COLLECT=200      # upper bound on message ids pulled per tick
MAIL_POLL_BOOTSTRAP_HOURS=1    # first poll of a new mailbox looks back this far
MAIL_POLL_CURSOR_OVERLAP_SEC=120  # re-ask this far before the cursor; dedupe makes it free
MAIL_PENDING_RETRY_HOURS=24    # re-post window for digests Discord rejected

MAIL_AUTH_ALERT_THROTTLE_HOURS=6  # a dead token pings Discord at most this often
MAIL_MAX_ATTACHMENT_BYTES=7500000 # attachments larger than this are never downloaded
MAIL_DISCORD_MAX_UPLOAD_BYTES=7500000  # Discord's 8 MiB ceiling, with margin
MAIL_DISCORD_TIMEOUT_MS=15000

MAIL_AI_MODEL=gpt-4o-mini      # reuses OPENAI_API_KEY above
MAIL_AI_TIMEOUT_MS=30000
MAIL_AI_MAX_BODY_CHARS=12000
MAIL_AI_MAX_ATTACHMENT_CHARS=8000
MAIL_MAX_DELIVERY_ATTEMPTS=5   # give up on a digest Discord keeps rejecting
MAIL_AI_API_URL=               # override the OpenAI endpoint (proxy / Azure); blank = api.openai.com

# ============================================================
#  Client milestone alerts — Gmail → gpt-4o-mini → SendGrid → client
#  (src/services/clientMailNotifier.js)
# ============================================================
# Rides on the hourly mail poll. When a client's connected inbox receives a
# positive milestone (interview / assignment / offer), the client gets a
# branded SendGrid email. Rejections and noise are logged, never emailed.

CLIENT_MAIL_NOTIFY_ENABLED=1          # 0 disables client alerts (poll + Discord unaffected)
# Which AI categories email the client. Default = positive milestones only.
# 'assessment' is shown to the client as "Assignment".
CLIENT_MAIL_NOTIFY_CATEGORIES=interview,assessment,offer
CLIENT_MAIL_NOTIFY_MIN_PRIORITY=medium  # low|medium|high — skip low-confidence guesses
CLIENT_MAIL_NOTIFY_MAX_ATTEMPTS=4       # give up after this many failed SendGrid tries

# Sender identity for client alerts. Falls back to SENDGRID_FROM_EMAIL / "FlashFire".
CLIENT_MAIL_FROM_EMAIL=
CLIENT_MAIL_FROM_NAME=FlashFire
# CTA link in the email (your dashboard). Falls back to FRONTEND_URL.
CLIENT_DASHBOARD_URL=

# SendGrid transactional sender (shared with dashboard OTP).
# Key resolves as SENDGRID_API_KEY_1 || SENDGRID_API_KEY.
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=noreply@flashfirehq.com
SENDGRID_FROM_NAME=FlashFire
CLIENT_MAIL_LOGO_URL=https://portal.flashfirejobs.com/Logo.png  # header logo; set empty for wordmark only

# ---- Mail classification mode ----
# rules  = zero-cost regex classifier (default). No OpenAI calls at all.
# ai     = gpt-4o-mini (richer summaries + key points, small per-mail cost).
# Rules mode still detects interview/assignment/offer for client alerts; the
# client email shows the mail's subject + snippet instead of an AI-written summary.
MAIL_CLASSIFIER_MODE=rules

# ---- Client alert delivery channel + SMTP (proof-of-send) ----
# Client milestone alerts (interview/assignment/offer) are sent to the client's
# stored PAYMENT email (dashboardtrackings.paymentEmail). "smtp" (default) sends
# through the shared Gmail App-Password account so a copy is saved to that
# account's Sent folder as proof. Use the SAME SMTP_* values as clients-tracking.
CLIENT_MAIL_CHANNEL=smtp        # smtp | sendgrid
SMTP_USER=                      # full Gmail address, e.g. support@flashfirejobs.com
SMTP_PASS=                      # 16-char Google App Password (NOT the login password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_FROM_EMAIL=                # From address (default SMTP_USER)
SMTP_FROM_NAME=FlashFire Team
